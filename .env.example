# Public Supabase settings (safe to expose to the browser). Without them TapAct
# builds and runs in guest-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: canonical origin used in email links. Defaults to the current origin.
# NEXT_PUBLIC_SITE_URL=https://tap-act.vercel.app

# Public support contact shown on /privacy, /terms, and Settings → About.
# Required before a public launch. Use an address you actually read.
# Leave it unset until then. Addresses at example.com, example.org, example.net,
# and example.edu are ignored so a sample address is never published.
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Web Push. Generate a key pair locally with `npx web-push generate-vapid-keys`.
# Put the public key here and in Vercel. Never commit the private key.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
