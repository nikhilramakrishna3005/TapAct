# Public Supabase settings (safe to expose to the browser). Without them TapAct
# builds and runs in guest-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: canonical origin used in email links. Defaults to the current origin.
# NEXT_PUBLIC_SITE_URL=https://tap-act.vercel.app

# Web Push. Generate a key pair locally with `npx web-push generate-vapid-keys`.
# Put the public key here and in Vercel. Never commit the private key.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
